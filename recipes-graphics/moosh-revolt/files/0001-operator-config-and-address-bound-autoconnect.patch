diff --git a/lib/services/startup_autoconnect.dart b/lib/services/startup_autoconnect.dart
new file mode 100644
index 0000000..8843c57
--- /dev/null
+++ b/lib/services/startup_autoconnect.dart
@@ -0,0 +1,61 @@
+import 'dart:async';
+
+import 'package:moosh_revolt/services/settings_service.dart';
+import 'package:universal_ble/universal_ble.dart';
+
+/// Finds only explicitly remembered, enabled targets; device names are labels.
+/// Injected transport operations let tests exercise scan timing without BLE.
+Future<BleDevice?> findStartupDevice({
+  required SettingsProvider settings,
+  required Future<List<BleDevice>> Function() systemDevices,
+  required Stream<BleDevice> scanStream,
+  required Future<void> Function() startScan,
+  required Future<void> Function() stopScan,
+  Duration scanTimeout = const Duration(seconds: 5),
+}) async {
+  final targets = settings.rememberedDevices
+      .where((device) => device.autoConnect)
+      .map((device) => device.address.toLowerCase())
+      .toSet();
+  if (!settings.autoConnect || targets.isEmpty) return null;
+  bool matches(BleDevice device) =>
+      targets.contains(device.deviceId.toLowerCase());
+
+  try {
+    final connected = await systemDevices().timeout(scanTimeout);
+    for (final device in connected) {
+      if (matches(device)) return device;
+    }
+  } catch (_) {
+    // Some platforms do not expose system devices. Discovery can still work.
+  }
+
+  final found = Completer<BleDevice?>();
+  // Subscribe before starting discovery, including synchronously emitted events.
+  final subscription = scanStream.listen(
+    (device) {
+      if (!found.isCompleted && matches(device)) found.complete(device);
+    },
+    onError: (Object error, StackTrace trace) {
+      if (!found.isCompleted) found.completeError(error, trace);
+    },
+    onDone: () {
+      if (!found.isCompleted) found.complete(null);
+    },
+  );
+  try {
+    // One overall deadline: unrelated advertisements must not extend the scan.
+    final result = await Future.wait<Object?>([
+      Future<void>.sync(startScan),
+      found.future,
+    ], eagerError: true).timeout(scanTimeout, onTimeout: () => [null, null]);
+    return result[1] as BleDevice?;
+  } finally {
+    await subscription.cancel();
+    try {
+      await stopScan().timeout(scanTimeout);
+    } catch (_) {
+      // Always release our listener, even when the platform cannot stop a scan.
+    }
+  }
+}
diff --git a/lib/services/startup_config.dart b/lib/services/startup_config.dart
new file mode 100644
index 0000000..c2f960d
--- /dev/null
+++ b/lib/services/startup_config.dart
@@ -0,0 +1,131 @@
+import 'dart:convert';
+
+import 'package:moosh_revolt/models/remembered_device.dart';
+
+import 'startup_config_stub.dart'
+    if (dart.library.io) 'startup_config_io.dart'
+    as platform;
+
+/// Validated operator overrides, applied after saved preferences at startup.
+class StartupConfig {
+  StartupConfig._(this.values);
+
+  final Map<String, dynamic> values;
+
+  static Future<StartupConfig> load({String? path}) async {
+    final text = await platform.readStartupConfig(path: path);
+    return parse(text == null ? <String, dynamic>{} : jsonDecode(text));
+  }
+
+  static StartupConfig parse(dynamic input) {
+    if (input is! Map || input.keys.any((key) => key is! String)) {
+      throw const FormatException('configuration must be a JSON object');
+    }
+    const keys = {
+      'schemaVersion',
+      'autoConnect',
+      'skipUpgrade',
+      'sampleRateHz',
+      'graphMaxPoints',
+      'darkMode',
+      'showFloatingReadings',
+      'rememberedDevices',
+    };
+    for (final key in input.keys) {
+      if (!keys.contains(key)) throw FormatException('unknown setting: $key');
+    }
+    if (input.containsKey('schemaVersion') &&
+        (input['schemaVersion'] is! int || input['schemaVersion'] != 1)) {
+      throw const FormatException(
+        'unsupported schemaVersion; expected integer 1',
+      );
+    }
+    for (final key in [
+      'autoConnect',
+      'skipUpgrade',
+      'darkMode',
+      'showFloatingReadings',
+    ]) {
+      if (input.containsKey(key) && input[key] is! bool) {
+        throw FormatException('$key must be a boolean');
+      }
+    }
+    if (input.containsKey('sampleRateHz') &&
+        (input['sampleRateHz'] is! int ||
+            ![
+              125,
+              250,
+              500,
+              1000,
+              2000,
+              4000,
+              8000,
+            ].contains(input['sampleRateHz']))) {
+      throw const FormatException('unsupported sampleRateHz');
+    }
+    if (input.containsKey('graphMaxPoints') &&
+        (input['graphMaxPoints'] is! int ||
+            input['graphMaxPoints'] < 2 ||
+            input['graphMaxPoints'] > 100000)) {
+      throw const FormatException(
+        'graphMaxPoints must be between 2 and 100000',
+      );
+    }
+    final values = Map<String, dynamic>.from(input);
+    if (input.containsKey('rememberedDevices')) {
+      final devices = input['rememberedDevices'];
+      if (devices is! List) {
+        throw const FormatException('rememberedDevices must be an array');
+      }
+      final addresses = <String>{};
+      final normalized = <Map<String, dynamic>>[];
+      for (final device in devices) {
+        if (device is! Map<String, dynamic> ||
+            device.keys.any(
+              (k) => !['address', 'name', 'autoConnect'].contains(k),
+            ) ||
+            device['address'] is! String ||
+            !RegExp(
+              r'^(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$',
+            ).hasMatch(device['address'] as String) ||
+            device['name'] is! String ||
+            (device['name'] as String).trim().isEmpty ||
+            (device.containsKey('autoConnect') &&
+                device['autoConnect'] is! bool)) {
+          throw const FormatException(
+            'invalid remembered device: expected Bluetooth MAC address, name, and optional boolean autoConnect',
+          );
+        }
+        final address = (device['address'] as String).toUpperCase();
+        if (!addresses.add(address)) {
+          throw const FormatException('duplicate remembered device address');
+        }
+        normalized.add(
+          Map<String, dynamic>.unmodifiable({
+            ...device,
+            'address': address,
+            'name': (device['name'] as String).trim(),
+          }),
+        );
+      }
+      values['rememberedDevices'] = List<Map<String, dynamic>>.unmodifiable(
+        normalized,
+      );
+    }
+    return StartupConfig._(Map<String, dynamic>.unmodifiable(values));
+  }
+
+  List<RememberedDevice>? get rememberedDevices {
+    final devices = values['rememberedDevices'] as List?;
+    return devices
+        ?.map(
+          (dynamic device) => RememberedDevice(
+            address: device['address'] as String,
+            name: device['name'] as String,
+            autoConnect: device['autoConnect'] as bool? ?? true,
+            rememberedAt: DateTime.fromMillisecondsSinceEpoch(0),
+          ),
+        )
+        .toList();
+  }
+}
diff --git a/lib/services/startup_config_io.dart b/lib/services/startup_config_io.dart
new file mode 100644
index 0000000..ed160e9
--- /dev/null
+++ b/lib/services/startup_config_io.dart
@@ -0,0 +1,17 @@
+import 'dart:io';
+
+Future<String?> readStartupConfig({String? path}) async {
+  final explicit = path ?? Platform.environment['MOOSHREVOLT_CONFIG'];
+  if (explicit != null && explicit.trim().isEmpty) {
+    throw const FormatException('MOOSHREVOLT_CONFIG must not be empty');
+  }
+  if (explicit == null && !Platform.isLinux) return null;
+  final file = File(explicit ?? '/etc/moosh-revolt/config.json');
+  try {
+    return await file.readAsString();
+  } on FileSystemException catch (error) {
+    // Only an absent default is optional; permission and read errors fail closed.
+    if (explicit == null && error.osError?.errorCode == 2) return null;
+    rethrow;
+  }
+}
